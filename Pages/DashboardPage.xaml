<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PROJECT.ViewModels"
             x:Class="PROJECT.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="24">

            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Image Grid.Column="0" Source="logo.png" WidthRequest="36" HeightRequest="36"/>
            </Grid>

            <Label Text="Your Days" FontSize="36" FontAttributes="Bold" TextColor="{StaticResource MidnightBlue}" />
            <Label Text="at a Glance" FontSize="24" TextColor="{StaticResource MidnightBlue}" Margin="0,-10,0,0"/>

            <Picker ItemsSource="{Binding Years}" 
                    SelectedItem="{Binding SelectedYear}" 
                    Title="Select Year"
                    WidthRequest="150"
                    HorizontalOptions="Start"
                    TextColor="{StaticResource MidnightBlue}"
                    FontAttributes="Bold" />

            <GraphicsView x:Name="ChartView" HeightRequest="220"/>

            <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 24" StrokeThickness="0" Padding="16">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,0" Radius="5" Opacity="0.2"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Daily Inspiration" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>

                    <Image Source="{Binding QuoteImage}" 
                           HeightRequest="150" 
                           Aspect="AspectFit" 
                           HorizontalOptions="Center" />

                    <Label Text="{Binding Quote}" 
                           TextColor="{StaticResource Secondary}" 
                           HorizontalOptions="Center" 
                           HorizontalTextAlignment="Center"
                           FontAttributes="Italic"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="New Entry" 
                    Command="{Binding NewEntryCommand}" 
                    FontAttributes="Bold"
                    CornerRadius="25"
                    HeightRequest="50"/>

            <Border StrokeShape="RoundRectangle 24"
                    BackgroundColor="{StaticResource Secondary}"
                    StrokeThickness="0"
                    Padding="24"
                    HorizontalOptions="Fill">

                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,0" Radius="5" Opacity="0.2"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                    <Label Text="Average Mood" 
                           TextColor="{StaticResource Primary}" 
                           FontSize="20"
                           FontAttributes="Bold" 
                           HorizontalOptions="Center"/>

                    <Label Text="{Binding AverageMoodText}"
                           TextColor="{StaticResource Primary}"
                           FontSize="60" 
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>

                    <Image Source="{Binding AverageMoodImage}" 
                           HeightRequest="180" 
                           Aspect="AspectFit"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>